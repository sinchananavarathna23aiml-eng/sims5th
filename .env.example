# Example: Set to your MongoDB connection string (do NOT commit real credentials)
MONGODB_URI=your_mongodb_connection_string

# JWT Secret Key (replace locally; do NOT commit real secrets)
JWT_SECRET=replace_with_a_long_random_secret

# Server Port
PORT=3000

# Set to true to run server without MongoDB connection
DISABLE_MONGODB=false

# Optional: customize initial seeded users
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@example.com

SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=ChangeMeManager123!
SEED_MANAGER_NAME=Manager User
SEED_MANAGER_EMAIL=manager@example.com

SEED_USER_USERNAME=user
SEED_USER_PASSWORD=ChangeMeUser123!
SEED_USER_NAME=Regular User
SEED_USER_EMAIL=user@example.com
